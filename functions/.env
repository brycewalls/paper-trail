# Who may use Paper Trail: comma separated Google account emails (#5, #8). Deployed with the functions as
# the ALLOWED_EMAILS parameter. firebase/firestore.rules names the same list; change both together.
ALLOWED_EMAILS=bryce.evan.walls@gmail.com
# The model that reads each document, and how hard it thinks. See README "Cost".
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# Google sign-in for the iPhone app (#14, #15). The web OAuth client (Firebase Auth's Google provider
# uses the same one); its secret is the GOOGLE_OAUTH_CLIENT_SECRET Functions secret. Not secret itself.
GOOGLE_OAUTH_CLIENT_ID=814219266285-pe2scelka1o9m98bt0v0f5fohumfs8f6.apps.googleusercontent.com
OAUTH_REDIRECT_URI=https://paper-trail-bw.web.app/oauth/callback
