# Who may use Paper Trail: comma separated Google account emails (#5, #8). Deployed with the functions as
# the ALLOWED_EMAILS parameter. firebase/firestore.rules names the same list; change both together.
ALLOWED_EMAILS=bryce.evan.walls@gmail.com
# The model that reads each document, and how hard it thinks. See README "Cost".
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
